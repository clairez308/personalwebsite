---
import BaseLayout from "../layouts/BaseLayout.astro";
import DividerTabs from "../components/DividerTabs.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Experiences from "../components/Experiences.astro";
import Journal from "../components/Journal.astro";
import Scrapbook from "../components/Scrapbook.astro";
import Postcard from "../components/Postcard.astro";
import Loader from "../components/Loader.astro";
import Thread from "../components/Thread.astro";
import { site } from "../content/site";
---

<BaseLayout title={site.title} description={site.description}>
  <Loader />
  <DividerTabs />
  <main>
    <Thread />
    <Hero />
    <Projects />
    <Experiences />
    <Journal />
    <Scrapbook />
    <Postcard />
  </main>
  <script>
    import "../scripts/home.ts";
  </script>
</BaseLayout>
