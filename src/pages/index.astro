---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import HobbiesCarousel from "../components/HobbiesCarousel.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

// Tile sizing for the bento layout: projects with a real photo get the
// bigger slots (alternating "big" and "wide"), text-only ones stay modest
// (mostly "small", with an occasional "tall" for rhythm). The rule is
// simple enough to read at a glance, but the two size pools alternate
// independently so it doesn't fall into a predictable row/column grid.
const bigSizes = ["big", "wide"] as const;
const smallSizes = ["small", "tall", "small"] as const;
let bigCount = 0;
let smallCount = 0;
const sizedProjects = projects.map((project) => {
  if (project.data.image) {
    const size = bigSizes[bigCount % bigSizes.length];
    bigCount++;
    return { project, size };
  }
  const size = smallSizes[smallCount % smallSizes.length];
  smallCount++;
  return { project, size };
});

const [atlas] = await getCollection("caseStudies");
---

<BaseLayout
  title="Claire Zhang, Product & Technology"
  description="Claire Zhang, product-minded builder and CS student at UBC. Case work, hackathon builds, and production code across product management and technology consulting."
  activePage="home"
>
  <!-- Hero -->
  <header class="hero" id="top">
    <div class="hero-blobs" aria-hidden="true">
      <div class="hero-blob hero-blob-1"></div>
      <div class="hero-blob hero-blob-2"></div>
      <div class="hero-blob hero-blob-3"></div>
    </div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="hero-eyebrow">Computer Science @ UBC</span>
        <h1>
          <span id="hero-typed">Hi, I'm Claire.</span><span class="hero-cursor" aria-hidden="true"></span>
        </h1>
        <p class="hero-lede">
          Welcome to my portfolio! I'm a CS student at UBC who likes
          building things, then figuring out if they were worth
          building in the first place. Lately that's meant a VC tool
          that placed 3rd at a case comp, dashboards I built during a
          co-op at a bank, and more hackathons than I can count.
        </p>
        <div class="hero-actions">
          <a href="/case-studies/atlas" class="btn btn-primary magnetic">Read the Atlas case study</a>
          <a href="/Claire_Zhang_Resume.pdf" download class="btn btn-ghost magnetic">Résumé</a>
        </div>
        <div class="hero-contact">
          <a href="https://www.linkedin.com/in/claire-zhang-985410301/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/clairez308" target="_blank" rel="noopener">GitHub</a>
          <a href="mailto:clairezhang838@gmail.com">Email</a>
        </div>
      </div>
      <div class="hero-photo-parallax">
        <div class="hero-photo-wrap">
          <img src="/assets/claire-headshot.jpg" alt="Claire Zhang" class="hero-photo" />
        </div>
      </div>
    </div>
  </header>

  <!-- Featured case study -->
  <section>
    <div class="container">
      <div class="featured spotlight reveal">
        <div class="featured-inner">
          <div>
            <span class="featured-tag">Featured Case Study</span>
            <h3>{atlas.data.title}, my take on an operating system for venture capital</h3>
            <p class="featured-desc">{atlas.data.description}</p>
            <div class="featured-stats">
              {
                atlas.data.featuredStats.map((stat) => (
                  <div class="stat">
                    <b>{stat.value}</b>
                    <span>{stat.label}</span>
                  </div>
                ))
              }
            </div>
          </div>
          <a href="/case-studies/atlas" class="featured-cta magnetic">Read the case study →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work -->
  <section id="work">
    <div class="container">
      <div class="section-head reveal">
        <span class="section-label">Selected Work</span>
        <h2>Projects I've shipped</h2>
        <p>
          A mix of product case work, hackathon builds, and independent
          projects. Some I built alone at 2am, some with a team on a
          36-hour clock. Hover a tile for the details.
        </p>
      </div>

      <div class="project-bento">
        {sizedProjects.map(({ project, size }, index) => (
          <ProjectCard project={project} index={index} size={size} />
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience">
    <div class="container">
      <div class="section-head reveal">
        <span class="section-label">Experience</span>
        <h2>Where I've worked</h2>
      </div>

      <div class="timeline">
        <div class="timeline-item reveal">
          <div class="timeline-org">CIBC</div>
          <div class="timeline-role">
            <h3>Business Systems Analyst</h3>
            <p>
              Validated SRRs and PCRs with DXC Cloud Networks, and
              reviewed vendor contracts and T&amp;Cs for vendor
              management and risk mitigation. Also built a Power BI
              dashboard from scratch to make sense of years of
              contractual data.
            </p>
          </div>
        </div>

        <div class="timeline-item reveal">
          <div class="timeline-org"><a href="https://www.susubc.ca/" target="_blank" rel="noopener">UBC Science Undergraduate Society</a></div>
          <div class="timeline-role">
            <h3>Associate Vice President, Communications</h3>
            <p>
              Own communications portfolio management, including web
              development. Led organization of SUS's first-ever
              hackathon, Hack the Coast, with 183 hackers. It's a
              community that makes up over 25% of the faculty's 10,000
              students but rarely gets events built for it.
            </p>
          </div>
        </div>

        <div class="timeline-item reveal">
          <div class="timeline-org"><a href="https://www.cs.ubc.ca/girlsmarts4tech/home" target="_blank" rel="noopener">UBC GIRLsmarts4tech</a></div>
          <div class="timeline-role">
            <h3>Workshop Facilitator</h3>
            <p>Organize Computer Science workshops for underrepresented youth.</p>
          </div>
        </div>

        <div class="timeline-item reveal">
          <div class="timeline-org"><a href="https://ubcyoucode.com/" target="_blank" rel="noopener">UBC Women in Data Science</a></div>
          <div class="timeline-role">
            <h3>youCode 2026 Logistics Coordinator</h3>
            <p>Spearheading logistics for the WICS x WIDS 24-hour hackathon for underrepresented genders in tech.</p>
          </div>
        </div>

        <div class="timeline-item reveal">
          <div class="timeline-org"><a href="https://xdhacks.org/vancouver/safehacks" target="_blank" rel="noopener">XdHacks Mini Vancouver</a></div>
          <div class="timeline-role">
            <h3>Co-Executive Director</h3>
            <p>Lead an executive team organizing SafeHacks, a BC-wide in-person high school hackathon.</p>
          </div>
        </div>

        <div class="timeline-item reveal">
          <div class="timeline-org"><a href="https://littlemountainmdv.com/" target="_blank" rel="noopener">Little Mountain</a></div>
          <div class="timeline-role">
            <h3>Retail Shift Supervisor</h3>
            <p>Run shifts and handle customer service on the retail floor.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Beyond work -->
  <HobbiesCarousel />
</BaseLayout>
