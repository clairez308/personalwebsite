---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/case-study/Section.astro";
import { getReleases } from "../../lib/releases";

export async function getStaticPaths() {
  const caseStudies = await getCollection("caseStudies");
  return caseStudies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const {
  title,
  subtitle,
  period,
  competition,
  hostedBy,
  deliverables,
  result,
  description,
  sections,
} = entry.data;

const releases = await getReleases();
const release = releases.find((r) => r.caseStudy?.id === entry.id)!;
---

<BaseLayout
  title={`${title}: Product Case Study | Claire Zhang`}
  description={description}
  activePage="case-study"
>
  <header class="cover spotlight">
    <div class="container cover-inner">
      <a href="/" class="nav-back">&larr; Back to portfolio</a>
      <span class="cover-eyebrow">{release.version} &middot; Flagship Release</span>
      <h1>{title}</h1>
      <p class="cover-sub">{subtitle}</p>
      <div class="cover-meta">
        <div class="meta-item">
          <span>Released</span>
          <b>{period}</b>
        </div>
        <div class="meta-item">
          <span>Competition</span>
          <b>{competition}</b>
        </div>
        <div class="meta-item">
          <span>Hosted by</span>
          <b>{hostedBy}</b>
        </div>
        <div class="meta-item">
          <span>Deliverables</span>
          <b>
            {deliverables.map((item, i) => (
              <>
                {i > 0 && " · "}
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener">{item.label}</a>
                ) : (
                  item.label
                )}
              </>
            ))}
          </b>
        </div>
        <div class="meta-item">
          <span>Result</span>
          <b>{result}</b>
        </div>
      </div>
    </div>
  </header>

  {sections.map((section) => <Section section={section} />)}

  <section>
    <div class="container">
      <div class="case-end reveal">
        <a href="/" class="btn btn-ghost magnetic">&larr; Back to portfolio</a>
      </div>
    </div>
  </section>
</BaseLayout>
