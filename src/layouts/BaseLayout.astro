---
import Footer from "../components/Footer.astro";
import ResumeNote from "../components/ResumeNote.astro";
import PencilCase from "../components/PencilCase.tsx";
import ClickSparkLayer from "../components/ClickSparkLayer.tsx";
// Tokens, fonts, Tailwind utilities and grain. The legacy global.css still
// styles the Atlas case study; it's removed piece by piece in later phases.
import "../styles/app.css";
import "../styles/global.css";
import "../styles/pencilcase.css";
import { site } from "../content/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

// Favicon: the Twemoji airplane.
const favicon = "/assets/graphics/plane.svg";

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL("/og.png", site.url).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f0e4" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Mark JS as available before first paint. The reveal styles key off .js.
      document.documentElement.classList.replace("no-js", "js");
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <ResumeNote />

    <slot />

    <Footer />

    <button type="button" class="to-top" data-to-top aria-label="Back to top">↑</button>

    <ClickSparkLayer client:only="react" />
    <PencilCase client:idle />

    <script>
      import "../scripts/core.ts";
    </script>
  </body>
</html>
