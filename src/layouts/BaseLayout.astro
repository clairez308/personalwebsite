---
import Footer from "../components/Footer.astro";
import ResumeNote from "../components/ResumeNote.astro";
import PencilCase from "../components/PencilCase.tsx";
import ClickSparkLayer from "../components/ClickSparkLayer.tsx";
// Tokens, fonts, Tailwind utilities and grain. The legacy global.css still
// styles the Atlas case study; it's removed piece by piece in later phases.
import "../styles/app.css";
import "../styles/global.css";
import "../styles/pencilcase.css";
import { site } from "../content/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Cpath fill='%233730a3' d='M462.3 62.6C407.5 15.9 326 24.3 275.7 76.2L256 96.5l-19.7-20.3C186.1 24.3 104.5 15.9 49.7 62.6c-62.8 53.6-66.1 149.8-9.9 207.9l193.5 199.8c12.5 12.9 32.8 12.9 45.3 0l193.5-199.8c56.3-58.1 53-154.3-9.8-207.9z'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <script is:inline>
      // Mark JS as available before first paint. The reveal styles key off .js.
      document.documentElement.classList.replace("no-js", "js");
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <ResumeNote />

    <slot />

    <Footer />

    <ClickSparkLayer client:only="react" />
    <PencilCase client:idle />

    <script>
      import "../scripts/core.ts";
    </script>
  </body>
</html>
