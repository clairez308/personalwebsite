---
import ProjectDeck, { type DeckItem } from "./ProjectDeck.tsx";
import { getReleases } from "../lib/releases";
import "../styles/projects.css";

// Atlas first (the flagship), then the other projects newest first.
const releases = [...(await getReleases())].reverse();
const flagship = releases.find((r) => r.isFlagship)!;
const projectReleases = releases.filter((r) => r.kind === "project");

// A small, stable tilt per card so it looks placed by hand (not random per render).
const tiltFor = (id: string) => {
  let h = 0;
  for (const c of id) h = (h * 31 + c.charCodeAt(0)) | 0;
  return (Math.abs(h) % 7) - 3;
};

const linkLabel = (key: "live" | "github") => (key === "github" ? "github ↗" : "live ↗");

const atlasCase = flagship.caseStudy!.data;
const items: DeckItem[] = [
  {
    id: "atlas",
    version: flagship.version,
    title: flagship.title,
    period: flagship.period,
    year: String(flagship.date.getFullYear()),
    image: "/assets/atlas-team.jpg",
    result: atlasCase.result,
    description: atlasCase.description,
    stack: [],
    links: [{ label: "read the case study →", href: flagship.href }],
    flagship: true,
    callouts: atlasCase.featuredStats.map((s) => `${s.value}: ${s.label}`),
    rotate: 0,
  },
  ...projectReleases.map((release) => {
    const data = release.project!.data;
    const links = (Object.keys(data.links ?? {}) as ("live" | "github")[])
      .filter((k) => data.links?.[k])
      .map((k) => ({ label: linkLabel(k), href: data.links![k]! }));
    return {
      id: release.project!.id,
      version: release.version,
      title: data.title,
      period: data.period,
      year: String(release.date.getFullYear()),
      image: data.image ?? "",
      result: data.result,
      description: data.description,
      stack: data.stack,
      links,
      flagship: false,
      callouts: [],
      rotate: tiltFor(release.project!.id),
    };
  }),
];
---

<section id="work" class="projects scroll-mt-8 px-4 py-20 md:px-8">
  <div class="projects-bg" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-[1080px]">
    <p class="font-mono text-sm text-ink-soft">01 · things I built</p>
    <h2 class="font-display mt-2 text-4xl md:text-5xl">Cool projects I've built</h2>

    <div class="projects-grid mt-10">
      <nav aria-label="Projects index" class="toc">
        <ol class="list-none pl-0">
          {
            items.map((item, i) => (
              <li>
                <a href={`#work-${item.id}`} class="toc-row" data-toc={item.id} data-index={i}>
                  <span class="font-mono text-xs text-ink-soft">{item.version}</span>
                  <span class="toc-title font-display">{item.title}</span>
                  <span class="toc-leader" aria-hidden="true"></span>
                  <span class="font-mono text-xs text-ink-soft">{item.year}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="psst font-hand text-lg text-ink-soft">Atlas first, the rest newest first.</p>
        <p class="font-hand text-lg text-ink-soft">psst, hold shift</p>
      </nav>

      <div class="deck-wrap">
        <ProjectDeck items={items} client:visible />
      </div>
    </div>
  </div>
</section>
