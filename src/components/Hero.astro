---
import { site } from "../content/site";
import HeroSticker from "./HeroSticker.tsx";

const { hero, socials, resumePath } = site;

// Each margin note gets a small Twemoji sticker next to it (CC-BY 4.0, see the footer).
const noteIcons = ["/assets/graphics/memo.svg", "/assets/graphics/star.svg", "/assets/graphics/plane.svg", "/assets/graphics/notebook.svg"];
---

<header id="top" class="relative">
  <!-- Faint stickers behind the copy: the slowest parallax layer -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <img data-depth="0.25" src="/assets/graphics/star.svg" alt="" class="absolute hidden left-[8%] top-[18%] h-10 w-10 opacity-50 md:block" />
    <img data-depth="0.25" src="/assets/graphics/sun.svg" alt="" class="absolute right-[10%] top-[60%] hidden h-9 w-9 opacity-60 md:block" />
  </div>

  <div data-hero-content class="mx-auto grid max-w-[1080px] items-center gap-10 px-4 pb-24 pt-24 md:grid-cols-[1.15fr_0.85fr] md:px-8 md:pt-32">
    <div>
      <p class="font-hand text-2xl text-tomato">{hero.handwritten}</p>
      <h1 class="font-display mt-2 text-5xl leading-tight md:text-7xl">{hero.headline}</h1>
      <p class="mt-6 max-w-prose text-lg text-ink-soft">{hero.lede}</p>
      <ul class="mt-5 flex flex-wrap gap-2 font-mono text-sm text-ink-soft">
        {hero.tags.map((tag) => <li>[{tag}]</li>)}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#work" class="rounded-md bg-tomato px-5 py-3 text-paper shadow-sm hover:brightness-95">see my work ↓</a>
        <a href={resumePath} target="_blank" rel="noopener" class="rounded-md border-2 border-ink px-5 py-3 hover:bg-paper-deep">résumé ↗</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-4 font-mono text-sm">
        <li><a class="underline decoration-kraft underline-offset-4" href={socials.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a class="underline decoration-kraft underline-offset-4" href={socials.github} target="_blank" rel="noopener">GitHub</a></li>
        <li><a class="underline decoration-kraft underline-offset-4" href={`mailto:${socials.email}`}>Email</a></li>
      </ul>
    </div>

    <div class="mx-auto w-full max-w-sm">
      <div data-depth="0.9" class="relative">
        <div class="sticker-wrap relative aspect-[4/5] w-full">
          <!-- Real image in the HTML. The sticker island takes over once it mounts. -->
          <img
            src="/assets/claire-headshot.jpg"
            alt="Claire Zhang"
            width="800"
            height="1000"
            class="sticker-fallback absolute inset-0 h-full w-full -rotate-2 rounded-sm border-[10px] border-white object-cover shadow-lg"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <div class="sticker-island absolute inset-0">
            <HeroSticker client:visible />
          </div>
        </div>
      </div>

      <!-- The notes sit under the photo, so nothing covers it. -->
      <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-3" aria-label="Notes about me">
        {
          hero.annotations.map((note, i) => (
            <li class="flex items-center gap-2 font-hand text-xl leading-tight text-ink">
              <img src={noteIcons[i % noteIcons.length]} alt="" width="24" height="24" class="h-6 w-6 flex-none" />
              <span>{note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>
