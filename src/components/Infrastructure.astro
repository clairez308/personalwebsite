---
interface Entry {
  scope: string;
  name: string;
  date: string;
  logo?: string;
  description: string;
  url?: string;
  current?: boolean;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<div class="infra-file reveal">
  <div class="infra-file-bar">
    <span class="infra-dot infra-dot--a"></span>
    <span class="infra-dot infra-dot--b"></span>
    <span class="infra-dot infra-dot--c"></span>
    <span class="infra-filename">dependencies.json</span>
  </div>
  <div class="infra-body">
    <p class="infra-punct">{"{"}</p>
    {
      entries.map((entry, i) => (
        <div class="infra-entry">
          <div class={`infra-badge ${!entry.logo ? `infra-badge--fallback-${(i % 6) + 1}` : ""}`}>
            {entry.logo ? (
              <img src={entry.logo} alt="" loading="lazy" />
            ) : (
              <span class="infra-badge-initial">{entry.scope.trim().charAt(0).toUpperCase()}</span>
            )}
          </div>
          <div class="infra-entry-body">
            <p class="infra-line">
              <span class="infra-code">
                <span class="infra-key">
                  {entry.url ? (
                    <a href={entry.url} target="_blank" rel="noopener">"@{entry.scope}/{entry.name}"</a>
                  ) : (
                    <>"@{entry.scope}/{entry.name}"</>
                  )}
                </span>
                <span class="infra-punct">: </span>
                <span class="infra-value">"{entry.date}"</span>
                {i < entries.length - 1 && <span class="infra-punct">,</span>}
              </span>
              {entry.current && <span class="release-badge current">current</span>}
            </p>
            <p class="infra-comment">// {entry.description}</p>
          </div>
        </div>
      ))
    }
    <p class="infra-punct">{"}"}</p>
  </div>
</div>
