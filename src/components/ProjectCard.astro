---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const { title, url, period, result, bullets, stack, image } = project.data;
const variant = (index % 3) + 1;
const initial = title.trim().charAt(0);
---

<div class="project-card tilt-card reveal">
  <a href={url} target="_blank" rel="noopener" class="project-banner-link" aria-hidden="true" tabindex="-1">
    {
      image ? (
        <div class="project-banner">
          <img src={image} alt="" loading="lazy" />
        </div>
      ) : (
        <div class={`project-banner project-banner--placeholder project-banner--${variant}`}>
          <span class="project-banner-initial">{initial}</span>
        </div>
      )
    }
  </a>
  <div class="project-card-body">
    <div class="project-top">
      <h3><a href={url} target="_blank" rel="noopener">{title}</a></h3>
      <span class="project-period">{period}</span>
    </div>
    {result && <span class="project-result">{result}</span>}
    <ul>
      {bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
    <div class="project-stack">
      {stack.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
</div>
