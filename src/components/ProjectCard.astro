---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
  size: "big" | "wide" | "tall" | "small";
}

const { project, index, size } = Astro.props;
const { title, url, period, result, bullets, stack, image } = project.data;
const colorVariant = (index % 3) + 1;
const initial = title.trim().charAt(0);

// Small tiles don't have room for the full write-up, so they get the
// shortest, most concrete line rather than everything truncated at random.
const bulletLimit = { small: 1, tall: 2, wide: bullets.length, big: bullets.length }[size];
const visibleBullets = bullets.slice(0, bulletLimit);
---

<div class={`project-tile project-tile--${size} reveal`}>
  <div class="project-tile-media">
    {
      image ? (
        <img src={image} alt="" loading="lazy" />
      ) : (
        <div class={`project-tile-placeholder project-tile-placeholder--${colorVariant}`}>
          <span>{initial}</span>
        </div>
      )
    }
  </div>

  <span class="project-tile-period">{period}</span>

  <div class="project-tile-info">
    <h3><a href={url} target="_blank" rel="noopener">{title}</a></h3>
    {result && <span class="project-result">{result}</span>}
  </div>

  <div class="project-tile-overlay">
    <div class="project-tile-overlay-head">
      <h3><a href={url} target="_blank" rel="noopener">{title}</a></h3>
      {result && <span class="project-result">{result}</span>}
    </div>
    <div class="project-tile-overlay-body">
      <ul>
        {visibleBullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
      <div class="project-stack">
        {stack.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </div>
</div>
