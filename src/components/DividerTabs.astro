---
import { site } from "../content/site";

// Notebook divider tabs on the right edge (desktop, always visible). On mobile
// they collapse into one button that opens the same list.
const colors = ["bg-washi-pink", "bg-kraft", "bg-sage", "bg-butter", "bg-washi-pink"];
---

<nav aria-label="Sections" class="tabs-desktop fixed right-0 top-1/3 z-40 hidden flex-col items-end gap-2 md:flex">
  {
    site.sections.map((s, i) => (
      <a
        href={`#${s.id}`}
        data-tab={s.id}
        class={`tab ${colors[i % colors.length]}`}
      >
        {s.label}
      </a>
    ))
  }
</nav>

<details class="tabs-mobile fixed right-3 top-3 z-40 md:hidden">
  <summary class="cursor-pointer list-none rounded-md border-2 border-ink bg-tomato px-3 py-2 font-mono text-sm font-semibold text-paper shadow-md">
    sections
  </summary>
  <nav aria-label="Sections (mobile)" class="mt-2 flex flex-col items-end gap-2 rounded-md border-2 border-ink bg-paper p-2 shadow-md">
    {
      site.sections.map((s) => (
        <a href={`#${s.id}`} data-tab={s.id} class="tab-mobile">
          {s.label}
        </a>
      ))
    }
  </nav>
</details>
