---
import { site } from "../content/site";

// Notebook divider tabs pinned to the right edge (desktop). On mobile they
// collapse into one bookmark button that opens the same list.
const colors = ["bg-washi-pink", "bg-kraft", "bg-sage", "bg-butter", "bg-washi-pink"];
---

<nav aria-label="Sections" class="fixed right-0 top-1/3 z-40 hidden flex-col items-end gap-2 md:flex">
  {
    site.sections.map((s, i) => (
      <a
        href={`#${s.id}`}
        data-tab={s.id}
        class={`${colors[i % colors.length]} font-mono text-xs text-ink rounded-l-md px-3 py-2 shadow-sm translate-x-[50%] transition-transform duration-300 hover:translate-x-0 focus-visible:translate-x-0 data-[active=true]:translate-x-0`}
      >
        {s.label}
      </a>
    ))
  }
</nav>

<details class="fixed right-3 top-3 z-40 md:hidden">
  <summary class="cursor-pointer list-none rounded-md bg-tomato px-3 py-2 font-mono text-xs text-paper shadow-sm">
    sections
  </summary>
  <nav aria-label="Sections (mobile)" class="mt-2 flex flex-col items-end gap-2 rounded-md bg-paper-deep p-2 shadow">
    {
      site.sections.map((s) => (
        <a href={`#${s.id}`} data-tab={s.id} class="font-mono text-sm text-ink px-2 py-1 rounded data-[active=true]:bg-butter">
          {s.label}
        </a>
      ))
    }
  </nav>
</details>
