---
import { getCollection } from "astro:content";
import ScrapbookBoard, { type HobbyPhoto } from "./ScrapbookBoard.tsx";
import "../styles/scrapbook.css";

const items = await getCollection("hobbies");
const photos: HobbyPhoto[] = items.map((item) => ({
  id: item.id,
  name: item.data.name,
  src: item.data.photos[0],
  caption: item.data.caption,
}));
---

<section id="play" class="scrapbook-section scroll-mt-8 px-4 py-20 md:px-8">
  <div class="mx-auto max-w-[1080px]">
    <h2 class="font-display mt-2 text-4xl md:text-5xl">Beyond work</h2>
    <p class="mt-3 max-w-prose text-ink-soft">
      A corkboard of photos and stickers. Move things around, draw on it, and save your page if you like it.
    </p>

    <div class="mt-10">
      <!-- The photos are in the HTML too. The board takes over once it hydrates. -->
      <noscript>
        <ul class="grid grid-cols-2 gap-6 md:grid-cols-3">
          {photos.map((p) => (
            <li>
              <img src={p.src} alt={p.name} loading="lazy" class="aspect-square w-full object-cover" />
            </li>
          ))}
        </ul>
      </noscript>
      <ScrapbookBoard photos={photos} client:visible />
    </div>
  </div>
</section>
