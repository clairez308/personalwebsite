---
import { getCollection } from "astro:content";

const items = await getCollection("hobbies");
---

<section id="play" class="scroll-mt-8 px-4 py-20 md:px-8">
  <div class="mx-auto max-w-[1080px]">
    <p class="font-mono text-sm text-ink-soft">04 · off the clock</p>
    <h2 class="font-display mt-2 text-4xl md:text-5xl">Beyond work</h2>

    <ul class="mt-10 grid grid-cols-2 gap-6 md:grid-cols-3">
      {
        items.map((item, i) => (
          <li class="reveal">
            <figure class={`bg-white p-3 pb-6 shadow-md ${i % 2 ? "rotate-[1.5deg]" : "rotate-[-1.5deg]"}`}>
              <img src={item.data.photos[0]} alt={item.data.name} loading="lazy" decoding="async" class="aspect-square w-full object-cover" />
              <figcaption class="mt-3 font-mono text-xs text-ink-soft">
                {item.data.name}
                {!item.data.caption.startsWith("TODO") && <span class="ml-1 font-hand text-lg text-ink">{item.data.caption}</span>}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
