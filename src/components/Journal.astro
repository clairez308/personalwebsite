---
import { getCollection, render } from "astro:content";

const entries = (await getCollection("reflections")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const rendered = await Promise.all(entries.map(async (entry) => ({ entry, ...(await render(entry)) })));
---

<section id="journal" class="scroll-mt-8 px-4 py-20 md:px-8">
  <div class="mx-auto max-w-[1080px]">
    <p class="font-mono text-sm text-ink-soft">03 · notes to self</p>
    <h2 class="font-display mt-2 text-4xl md:text-5xl">Reflections</h2>
    <p class="mt-3 max-w-prose text-ink-soft">The story behind the roles and releases above, in my own words.</p>

    <div class="mt-10 space-y-12">
      {
        rendered.map(({ entry, Content }) => (
          <article class="reveal grid gap-6 border-t border-kraft/40 pt-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
            <div>
              <p class="font-mono text-sm text-ink-soft">
                {entry.data.period}
                {entry.data.tag && ` · ${entry.data.tag}`}
              </p>
              {(entry.data.photos ?? []).map((src) => (
                <img src={src} alt="" loading="lazy" decoding="async" class="mt-3 w-full rounded-sm border-[6px] border-white shadow-md" />
              ))}
            </div>
            <div>
              <h3 class="font-display text-2xl">{entry.data.title}</h3>
              <div class="mt-3 space-y-4 text-[1.02rem] leading-relaxed">
                <Content />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
