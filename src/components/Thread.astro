---
import { site } from "../content/site";

// The thread: one ink line that winds down the page through every section.
// Its path, stop positions and scroll drawing are built by src/scripts/thread.ts.
---

<div id="thread" class="thread" aria-hidden="true">
  <svg class="thread-svg" aria-hidden="true">
    <path class="thread-path" id="thread-path" d="" />
  </svg>
  <p class="thread-start" data-thread-start>start here ↓</p>
  {
    site.sections.map((s, i) => (
      <div class="thread-stop" data-stop={s.id}>
        <span class="thread-pin">{i + 1}</span>
        <span class="thread-label">{s.stop}</span>
      </div>
    ))
  }
  <img class="thread-plane" src="/assets/graphics/plane.svg" width="28" height="28" alt="" />
</div>
