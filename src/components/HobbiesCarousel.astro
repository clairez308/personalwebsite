---
import fs from "node:fs";
import path from "node:path";

// Auto-discovers whatever's in public/assets/hobbies. To add a photo, just
// drop a jpg/png/webp in that folder, no code or content file to touch.
const hobbiesDir = path.join(process.cwd(), "public/assets/hobbies");
const files = fs
  .readdirSync(hobbiesDir)
  .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
  .sort();
const images = files.map((f) => `/assets/hobbies/${f}`);
// duplicated once so the marquee can loop seamlessly at -50%
const looped = [...images, ...images];

const moodList = ["dancing", "yoga", "volunteering", "snowboarding", "travelling", "painting"]
  .map((m) => `"${m}"`)
  .join(", ");
---

<section class="hobbies">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-label">Beyond Work</span>
      <h2>I also love&hellip;</h2>
      <p class="hobbies-config">
        <span class="hobbies-config-comment">// beyond-work.config</span>
        <span class="hobbies-config-line">mood: [{moodList}]</span>
      </p>
    </div>
  </div>
  <div class="hobbies-carousel">
    <div class="carousel-track">
      {
        looped.map((src) => (
          <div class="hobby-card">
            <img src={src} alt="" loading="lazy" />
          </div>
        ))
      }
    </div>
  </div>
</section>
