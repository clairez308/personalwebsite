---
import { getCollection } from "astro:content";
import ExperienceBoard, { type Experience } from "./ExperienceBoard.tsx";
import "../styles/experiences.css";

// Order as written in experiences.yaml (current and incoming roles first in each group).
const entries = await getCollection("experiences");
const items: Experience[] = entries.map((entry) => ({
  id: entry.id,
  org: entry.data.org,
  role: entry.data.role,
  dates: entry.data.dates,
  category: entry.data.category,
  summary: entry.data.summary,
  bullets: entry.data.bullets,
  logo: entry.data.logo,
  image: entry.data.image,
  url: entry.data.url,
  current: entry.data.current,
  incoming: entry.data.incoming,
}));
---

<section id="experience" class="experience scroll-mt-8 px-4 py-20 md:px-8">
  <div class="mx-auto max-w-[1080px]">
    <h2 class="font-display mt-2 text-4xl md:text-5xl">What's running underneath</h2>
    <p class="mt-3 max-w-prose text-ink-soft">Work, leadership and community roles. Pick a card to open the letter.</p>

    <div class="mt-10">
      <!-- Without JavaScript the full list still renders here; the island takes over after hydration. -->
      <ExperienceBoard entries={items} client:visible />
    </div>
  </div>
</section>
