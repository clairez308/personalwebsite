---
import { getCollection, render } from "astro:content";

const rawNotes = await getCollection("reflections");
const notes = rawNotes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const rendered = await Promise.all(
  notes.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---

<section id="field-notes">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-label">Field Notes</span>
      <h2>Reflections along the way</h2>
      <p>The story behind the roles and releases above, in my own words.</p>
    </div>

    <div class="notes-feed">
      {
        rendered.map(({ entry, Content }) => {
          const photos = entry.data.photos ?? [];
          return (
            <article class="note-card reveal">
              <div class="note-header">
                <img src="/assets/claire-headshot.jpg" alt="" class="note-avatar" />
                <div class="note-byline">
                  <span class="note-author">Claire Zhang</span>
                  <span class="note-meta">
                    {entry.data.period}
                    {entry.data.tag && ` · ${entry.data.tag}`}
                  </span>
                </div>
              </div>

              {photos.length > 0 && (
                <div class="note-carousel">
                  <div class="note-carousel-track">
                    {photos.map((src) => (
                      <div class="note-carousel-slide">
                        <img src={src} alt="" loading="lazy" />
                      </div>
                    ))}
                  </div>
                  {photos.length > 1 && (
                    <>
                      <button type="button" class="note-carousel-btn note-carousel-prev" aria-label="Previous photo">&larr;</button>
                      <button type="button" class="note-carousel-btn note-carousel-next" aria-label="Next photo">&rarr;</button>
                      <div class="note-carousel-dots">
                        {photos.map((_, pi) => (
                          <span class={`note-carousel-dot${pi === 0 ? " active" : ""}`} data-index={pi} />
                        ))}
                      </div>
                    </>
                  )}
                </div>
              )}

              <h3 class="note-title">{entry.data.title}</h3>

              <div class="note-body-wrap">
                <div class="note-body">
                  <Content />
                </div>
                <button type="button" class="note-toggle">See more</button>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
