---
import { getCollection, render } from "astro:content";

const rawNotes = await getCollection("reflections");
const notes = rawNotes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const rendered = await Promise.all(
  notes.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---

<section id="field-notes">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-label">Field Notes</span>
      <h2>Reflections along the way</h2>
      <p>The story behind the roles and releases above, in my own words.</p>
    </div>

    <div class="notes-feed">
      {
        rendered.map(({ entry, Content }) => {
          const photos = entry.data.photos ?? [];
          const visiblePhotos = photos.slice(0, 4);
          const extraCount = photos.length - 4;
          return (
            <article class="note-card reveal">
              <div class="note-header">
                <img src="/assets/claire-headshot.jpg" alt="" class="note-avatar" />
                <div class="note-byline">
                  <span class="note-author">Claire Zhang</span>
                  <span class="note-meta">
                    {entry.data.period}
                    {entry.data.tag && ` · ${entry.data.tag}`}
                  </span>
                </div>
              </div>

              <h3 class="note-title">{entry.data.title}</h3>

              <div class="note-body-wrap">
                <div class="note-body">
                  <Content />
                </div>
                <button type="button" class="note-toggle">See more</button>
              </div>

              {photos.length > 0 && (
                <div
                  class={`note-photos note-photos--${visiblePhotos.length}`}
                  data-photos={JSON.stringify(photos)}
                >
                  {visiblePhotos.map((src, pi) => (
                    <button type="button" class="note-photo-btn" data-photo-index={pi}>
                      <img src={src} alt="" loading="lazy" />
                      {pi === 3 && extraCount > 0 && (
                        <span class="note-photo-more">+{extraCount}</span>
                      )}
                    </button>
                  ))}
                </div>
              )}
            </article>
          );
        })
      }
    </div>
  </div>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous photo">&larr;</button>
    <img src="" alt="" class="lightbox-image" id="lightbox-image" />
    <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next photo">&rarr;</button>
    <span class="lightbox-counter" id="lightbox-counter"></span>
  </div>
</section>
