---
import { getReleases } from "../lib/releases";

interface Props {
  activePage?: "home" | "case-study";
}
const { activePage = "home" } = Astro.props;
const releases = [...(await getReleases())].reverse();
---

<nav class="site-nav">
  <div class="container nav-inner">
    <a href="/" class="nav-mark">Claire Zhang</a>

    <div class="nav-versions">
      {
        releases.map((r) => {
          const classes = [
            r.isCurrent && "current",
            r.isFlagship && "flagship",
            r.isFlagship && activePage === "case-study" && "active",
          ]
            .filter(Boolean)
            .join(" ");
          const title = `${r.version} · ${r.period}${r.isFlagship ? " · Flagship release" : ""}${r.isCurrent ? " · Current" : ""}`;
          return (
            <a href={r.href} class={classes} title={title}>
              {r.version}
            </a>
          );
        })
      }
    </div>

    <div class="nav-links">
      <a href="/#infrastructure">Infrastructure</a>
      <a href="/Claire_Zhang_Resume.pdf" download class="nav-resume magnetic">Resume</a>
    </div>
  </div>
</nav>
